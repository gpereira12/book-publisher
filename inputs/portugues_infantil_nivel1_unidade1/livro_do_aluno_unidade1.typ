#atividade(1, "Sons do cotidiano: cachorro e carro", "Ouça os dois sons. Circule o cachorro.", imagem: "/inputs/portugues_infantil_nivel1_unidade1/assets/ilustracoes/atividade01_sons_cachorro_carro.jpeg", carlinho: "Olá! Eu sou o Carlinho, e vou estar com você em todas as páginas desta apostila. Hoje começamos uma aventura muito bonita: vamos aprender a ouvir com atenção os sons ao nosso redor. Você já reparou quantos sons diferentes existem? O latido do cachorro, a água correndo, o vento soprando nas árvores... Esta semana também vou ler para você uma parlenda muito antiga que diz 'Hoje é domingo, pé de cachimbo'. Peça para o adulto que está com você ler essa parlenda todos os dias, e logo você vai conhecer cada palavra de cor. Vamos juntos, com calma e alegria!")

#atividade(2, "Tracejado vertical", "Passe o lápis por cima das linhas pontilhadas, sempre de cima para baixo.", imagem: none, carlinho: none)

#atividade(3, "Pinte a maçã vermelha", "Pinte a maçã de vermelho.", imagem: "/inputs/portugues_infantil_nivel1_unidade1/assets/ilustracoes/atividade03_frutas.jpeg", carlinho: none)

#atividade(4, "Memória de sons: qual foi o segundo?", "Ouça os três sons com atenção. Depois, mostre qual foi o segundo som que você escutou.", imagem: none, carlinho: none)

#atividade(5, "Tracejado horizontal", "Passe o lápis por cima das linhas, seguindo sempre da esquerda para a direita.", imagem: none, carlinho: none)

#atividade(6, "Pinte o balão grande de azul", "Pinte o balão grande de azul.", imagem: none, carlinho: none)

#atividade(7, "Cole o sino no lugar certo", "Ouça os dois sons. Depois, cole a figura do sino no quadrado que tem o número um.", imagem: none, carlinho: none)

#atividade(8, "Tracejado ondulado como uma onda", "Passe o lápis por cima da linha que parece uma onda do mar.", imagem: none, carlinho: none)

#atividade(9, "Circule o copo", "Olhe bem os três objetos. Circule o copo.", imagem: none, carlinho: none)

#atividade(10, "Sons da natureza: chuva e trovão", "Escute com atenção. Quando ouvir a chuva, circule a imagem da chuva.", imagem: none, carlinho: none)

#atividade(11, "Tracejado circular", "Passe o lápis por cima dos círculos pontilhados, sempre girando no mesmo sentido.", imagem: none, carlinho: none)

#atividade(12, "Pinte o pássaro que está em cima", "Olhe os dois pássaros. Pinte aquele que está em cima do galho.", imagem: none, carlinho: none)

#atividade(13, "Parlenda: 'Hoje é domingo'", "Você já ouviu a parlenda 'Hoje é domingo, pé de cachimbo'. Agora escute duas palavras e circule a figura do cachimbo.", imagem: none, carlinho: none)

#atividade(14, "Ligue os pontos e pinte a estrela", "Ligue os pontos de um a cinco, seguindo a ordem. Depois, pinte a estrela da cor que você quiser.", imagem: none, carlinho: none)

#atividade(15, "Pinte o sol de amarelo", "Pinte o sol de amarelo.", imagem: none, carlinho: none)

#atividade(16, "Circule a cor vermelha", "Olhe para as três figuras. Circule a maçã.", imagem: none, carlinho: "Olá! Esta semana vamos descobrir as cores que estão ao nosso redor: o vermelho da maçã, o azul do céu, o amarelo do sol. Eu trouxe uma poesia linda sobre um colar cheio de contas coloridas — a Carolina tinha um colar com muitas cores! Vamos olhar bem para cada figura e aprender juntos. Estou aqui com você!")

#atividade(17, "Tracejado de círculos", "Passe o lápis por cima dos círculos, sempre no mesmo sentido.", imagem: none, carlinho: none)

#atividade(18, "Pinte o céu de azul", "Pinte o céu de azul.", imagem: none, carlinho: none)

#atividade(19, "Ouça e mostre a segunda cor", "Ouça os nomes das três cores. Depois, mostre a segunda cor que você ouviu.", imagem: none, carlinho: none)

#atividade(20, "Tracejado de quadrados", "Passe o lápis por cima dos quadrados, começando sempre pelo cantinho marcado.", imagem: none, carlinho: none)

#atividade(21, "Pinte o maior balão", "Olhe para os três balões. Pinte o maior de amarelo.", imagem: none, carlinho: none)

#atividade(22, "Cole a figura verde no quadrado 2", "Ouça os nomes das duas cores. Depois, cole a figura verde no quadrado que tem o número 2.", imagem: none, carlinho: none)

#atividade(23, "Tracejado ondulado colorido", "Passe o lápis vermelho por cima da primeira linha ondulada. Depois, use o azul na segunda, o amarelo na terceira e o verde na quarta.", imagem: none, carlinho: none)

#atividade(24, "Circule a flor que está dentro do vaso", "Olhe para as duas flores. Circule a flor que está dentro do vaso.", imagem: none, carlinho: none)

#atividade(25, "Ouça e circule o roxo", "Ouça as três cores. Circule a mancha roxa.", imagem: none, carlinho: none)

#atividade(26, "Tracejado de linha vertical", "Passe o lápis por cima das linhas retas, sempre de cima para baixo.", imagem: none, carlinho: none)

#atividade(27, "Pinte a uva de roxo e a laranja de laranja", "Pinte a uva de roxo. Depois, pinte a laranja de laranja.", imagem: none, carlinho: none)

#atividade(28, "Ouça a poesia e circule a conta vermelha", "Ouça a poesia sobre o colar de Carolina. Depois, circule a conta vermelha.", imagem: none, carlinho: none)

#atividade(29, "Tracejado de espiral", "Passe o lápis pela linha que vai girando para dentro, como um caracol.", imagem: none, carlinho: none)

#atividade(30, "Pinte as contas do colar com cores diferentes", "Pinte cada conta do colar de uma cor diferente. Use vermelho, azul, amarelo, verde, laranja e roxo.", imagem: none, carlinho: none)

#atividade(31, "Tracejado vertical — chuva caindo", "Passe o lápis por cima das linhas que parecem gotas de chuva caindo, sempre de cima para baixo.", imagem: none, carlinho: "Olá! Esta semana vamos treinar nossas mãozinhas para desenhar linhas retas, onduladas e até fazer espirais! Trouxe também uma parlenda muito divertida sobre os dedos da mão: 'Dedo mindinho, seu vizinho...' Você vai ouvir ela todos os dias e na sexta-feira vamos brincar de pintar cada dedinho. Preparado? Vamos lá!")

#atividade(32, "Sons da natureza — vento e folha", "Ouça os dois sons. Depois, circule a folha sendo levada pelo vento.", imagem: none, carlinho: none)

#atividade(33, "Pintura da mão esquerda", "Pinte apenas a mão esquerda de verde.", imagem: none, carlinho: none)

#atividade(34, "Tracejado horizontal — trilho de trem", "Passe o lápis sobre as linhas do trilho, sempre da esquerda para a direita.", imagem: none, carlinho: none)

#atividade(35, "Maior de três — balões no céu", "Pinte o balão maior de azul.", imagem: none, carlinho: none)

#atividade(36, "Colagem — sino e porta", "Ouça os dois sons. Cole a figura do sino no quadrado que tem o número 1.", imagem: none, carlinho: none)

#atividade(37, "Tracejado ondulado — cobra no chão", "Passe o lápis sobre a linha que parece uma cobra rastejando.", imagem: none, carlinho: none)

#atividade(38, "Bola entre objetos", "Pinte a bola que está entre a caixa e o livro.", imagem: none, carlinho: none)

#atividade(39, "Pássaro embaixo do galho", "Pinte o pássaro que está embaixo do galho de árvore.", imagem: none, carlinho: none)

#atividade(40, "Tracejado circular — bolas de sabão", "Passe o lápis sobre os círculos, fazendo bolas de sabão bem redondas.", imagem: none, carlinho: none)

#atividade(41, "Memória auditiva — três sons da casa", "Ouça os três sons. Depois, mostre qual foi o segundo som que você ouviu.", imagem: none, carlinho: none)

#atividade(42, "Pé direito pintado", "Pinte apenas o pé direito de laranja.", imagem: none, carlinho: none)

#atividade(43, "Parlenda dos dedos — reconhecimento auditivo", "Ouça as duas palavras da parlenda. Circule o dedo mindinho.", imagem: none, carlinho: none)

#atividade(44, "Tracejado zigue-zague — escada subindo", "Passe o lápis sobre as linhas que sobem como degraus de uma escada.", imagem: none, carlinho: none)

#atividade(45, "Integração final — mão, parlenda e tracejado", "Ouça a parlenda. Depois, pinte cada dedo com a cor que eu vou falar. Por último, ligue cada dedo até a palavra escrita embaixo.", imagem: "/inputs/portugues_infantil_nivel1_unidade1/assets/ilustracoes/atividade45_mao_parlenda.jpeg", carlinho: none)
